{
  "name": "@web-loom/template-core-vite-ssr",
  "version": "0.8.0",
  "description": "Reusable Vite SSR server and document helpers for template-core applications.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.es.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --watch=false",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "typescript": "5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  }
}
