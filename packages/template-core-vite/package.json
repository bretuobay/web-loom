{
  "name": "@web-loom/template-core-vite",
  "version": "0.9.0",
  "description": "Vite plugin for @web-loom/template-core: build-time precompile, dev analyze, dev precompile, and `.loom` file loading.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "loom.d.ts"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.es.js"
    },
    "./loom": {
      "types": "./loom.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --watch=false",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "dependencies": {
    "@web-loom/template-core": "*",
    "@web-loom/template-core-tooling": "*",
    "magic-string": "^0.30.11",
    "typescript": "5.8.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  }
}
