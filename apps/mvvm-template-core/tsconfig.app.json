{
  "compilerOptions": {
    "rootDir": "../..",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": {
      "@repo/models": ["../../packages/models/src"],
      "@repo/models/*": ["../../packages/models/src/*"],
      "@repo/view-models": ["../../packages/view-models/src"],
      "@repo/view-models/*": ["../../packages/view-models/src/*"],
      "@repo/shared": ["../../packages/shared/src"],
      "@repo/shared/*": ["../../packages/shared/src/*"],
      "@web-loom/mvvm-core": ["../../packages/mvvm-core/src"],
      "@web-loom/mvvm-core/*": ["../../packages/mvvm-core/src/*"],
      "@web-loom/query-core": ["../../packages/query-core/src"],
      "@web-loom/query-core/*": ["../../packages/query-core/src/*"],
      "@web-loom/signals-core": ["../../packages/signals-core/src"],
      "@web-loom/signals-core/*": ["../../packages/signals-core/src/*"],
      "@web-loom/router-core": ["../../packages/router-core/src"],
      "@web-loom/router-core/*": ["../../packages/router-core/src/*"],
      "@web-loom/template-core": ["../../packages/template-core/src"],
      "@web-loom/template-core/*": ["../../packages/template-core/src/*"],
      "@web-loom/template-core-vite/loom": ["../../packages/template-core-vite/loom.d.ts"],
      "@web-loom/view": ["../../packages/view/src"],
      "@web-loom/view/*": ["../../packages/view/src/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals", "vite/client"]
  },
  "include": ["src"]
}
