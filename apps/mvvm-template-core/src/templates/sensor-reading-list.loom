<a href="/" class="back-button" on:click.prevent="navigateFromClick">
  <img src="/back-arrow.svg" alt="Back to dashboard" class="back-arrow" />
</a>
<div class="card">
  <h1 class="card-title">Sensor Readings</h1>
  {{#if sensorReadings.data$.length > 0}}
    <ul class="card-content list">
      {{#each sensorReadings.data$ key=id}}
        <li class="list-item">
          Reading ID: {{ sensorId }}, Sensor ID: {{ sensorId }}, Timestamp:
          {{ formatTimestamp(timestamp) }}, Value: {{ value }}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p>No sensor readings found or still loading...</p>
  {{/if}}
</div>
