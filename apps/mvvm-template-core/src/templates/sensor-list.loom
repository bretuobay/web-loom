<a href="/" class="back-button">
  <img src="/back-arrow.svg" alt="Back to dashboard" class="back-arrow" />
</a>
<div class="card">
  <h1 class="card-title">Sensors</h1>
  {{#if sensors.data$.length > 0}}
    <ul class="card-content list">
      {{#each sensors.data$ key=id}}
        <li class="list-item">
          {{ greenhouse.name }} {{ type }} (Status: {{ status }})
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p>No sensors found or still loading...</p>
  {{/if}}
</div>
