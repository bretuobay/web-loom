<header class="header">
  <a href="/" class="header-item" on:click.prevent="navigateFromClick">
    Dashboard
  </a>
  <nav class="flex-container">
    {{#each navigationItems$ key=id}}
      <a href="/{{ id }}" class="header-item" on:click.prevent="navigateFromClick">
        <i class="icon-{{ icon }}"></i>
        {{ label }}
      </a>
    {{/each}}
  </nav>
</header>
