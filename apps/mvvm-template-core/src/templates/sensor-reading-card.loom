<div class="card">
  <a href="{{ href }}" class="card-header-link">
    <h3 class="card-title">Sensor Readings</h3>
  </a>
  <div class="card-content sensor-reading-card">
    <canvas id="sensorReadingsChart" use:renderChart="renderChart"></canvas>
  </div>
  <p class="card-content">Total Readings: {{ count }}</p>
</div>
