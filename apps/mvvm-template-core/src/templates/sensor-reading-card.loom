<div class="card">
  <a href="/sensor-readings" class="card-header-link" on:click.prevent="navigateFromClick">
    <h3 class="card-title">Sensor Readings</h3>
  </a>
  <div class="card-content sensor-reading-card">
    <canvas id="sensorReadingsChart" use:renderSensorReadingsChart="renderSensorReadingsChart"></canvas>
  </div>
  <p class="card-content">Total Readings: {{ sensorReadings.data$.length }}</p>
</div>
