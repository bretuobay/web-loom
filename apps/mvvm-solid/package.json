{
  "name": "mvvm-solid",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --build --force",
    "check-types": "tsc --build --force"
  },
  "dependencies": {
    "@repo/shared": "*",
    "@repo/view-models": "*",
    "@solidjs/router": "^0.15.3",
    "chart.js": "^4.4.3",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.4.6",
    "@types/chart.js": "^2.9.41",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "eslint": "^9.39.1",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.1.9"
  }
}
