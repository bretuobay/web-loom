{
  "name": "ecommerce-template-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @web-loom/template-core-vite run build",
    "dev": "vite",
    "dev:ssr": "tsx server.ts",
    "build:client": "tsc --noEmit -p tsconfig.app.json && vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.ts",
    "build": "pnpm run build:client && pnpm run build:server",
    "preview": "NODE_ENV=production tsx server.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@web-loom/design-core": "workspace:*",
    "@web-loom/event-bus-core": "workspace:*",
    "@web-loom/mvvm-core": "workspace:*",
    "@web-loom/mvvm-patterns": "workspace:*",
    "@web-loom/query-core": "workspace:*",
    "@web-loom/router-core": "workspace:*",
    "@web-loom/signals-core": "workspace:*",
    "@web-loom/store-core": "workspace:*",
    "@web-loom/template-core": "workspace:*",
    "@web-loom/template-core-router": "workspace:*",
    "@web-loom/template-core-vite-ssr": "workspace:*",
    "@web-loom/ui-core": "workspace:*",
    "@web-loom/ui-patterns": "workspace:*",
    "@web-loom/view": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@typescript-eslint/parser": "^8.46.0",
    "@web-loom/template-core-lint": "workspace:*",
    "@web-loom/template-core-vite": "workspace:*",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
